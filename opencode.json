{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["handoff/WORKFLOW.md", "handoff/PITFALLS.md"],
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git push -f*": "deny",
      "git push --force*": "deny",
      "git push origin main*": "deny",
      "git push origin HEAD:main*": "deny",
      "git reset --hard*": "ask",
      "git checkout main*": "ask",
      "rm -rf*": "ask",
      "npm install *": "ask",
      "npm i *": "ask",
      "npm run stress -- --update-baseline*": "ask"
    },
    "edit": {
      "*": "allow",
      "perf-baseline.json": "ask",
      ".github/*": "ask",
      "AGENTS.md": "ask",
      "CLAUDE.md": "ask",
      "opencode.json": "ask",
      "scripts/rules-check.mjs": "ask"
    }
  }
}
